#!/usr/bin/make -f
ifneq (,$(filter pkg.stereo-layer.av,$(DEB_BUILD_PROFILES)))
AV_ONLY = -DSTEREO_AV_ONLY=ON
endif

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=ON -DBUILD_EXAMPLES=OFF $(AV_ONLY)

override_dh_auto_test:
	QT_QPA_PLATFORM=offscreen CTEST_OUTPUT_ON_FAILURE=1 dh_auto_test

override_dh_makeshlibs:
	dh_makeshlibs -V
