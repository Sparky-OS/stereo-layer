Section: libdevel
Architecture: any
Build-Profiles: <!pkg.stereo-layer.av>
Depends: libstereo-dibr1 (= ${binary:Version}), ${misc:Depends}
Description: Development files for depth-image-based rendering without Qt
 The C headers stereo-dibr.h and stereo-dibr-gl.h, the pkg-config file
 stereo-dibr.pc, and the GLSL passes in /usr/share/stereo-dibr/glsl.

Package: libstereo-av1
Architecture: any
Multi-Arch: same
Depends: ${shlibs:Depends}, ${misc:Depends}
Description: Native multiview frame assembly for FFmpeg consumers
 Pairs the signalled MV-HEVC eyes at matching timestamps without resizing,
 retains presentation metadata and provides an ordinary base-view fallback.

