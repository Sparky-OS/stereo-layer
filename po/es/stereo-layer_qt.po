msgctxt "Stereo::PictureSave|"
msgid "The original picture could not be read completely."
msgstr "No se pudo leer por completo la imagen original."

msgctxt "Stereo::PictureSave|"
msgid "Metadata-only save requires a regular file, not a symbolic link."
msgstr "Guardar solo los metadatos requiere un archivo normal, no un enlace simbólico."

msgctxt "Stereo::PictureSave|"
msgid "The JPEG segments or scan data are truncated or invalid."
msgstr "Los segmentos JPEG o los datos de barrido están truncados o no son válidos."

msgctxt "Stereo::PictureSave|"
msgid "Lossless JPEG cannot yet be verified by the picture reader; the file was kept."
msgstr "El lector de imágenes aún no puede verificar JPEG sin pérdida; se conservó el archivo."

msgctxt "Stereo::PictureSave|"
msgid "The requested layout, eye order or view is invalid."
msgstr "La disposición, el orden de los ojos o la vista solicitada no es válida."

msgctxt "Stereo::PictureSave|"
msgid "The MPO is not a valid complete two-view disparity pair with matching base-viewpoint references."
msgstr "El MPO no es un par completo y válido de dos vistas de disparidad con referencias coincidentes a la vista base."

msgctxt "Stereo::PictureSave|"
msgid "JPS cannot describe the chosen packing. Choose side by side, top and bottom, rows, red/cyan or mono."
msgstr "JPS no puede describir la disposición elegida. Elija lado a lado, arriba y abajo, filas, rojo/cian o mono."

msgctxt "Stereo::PictureSave|"
msgid "JPS can describe only red/cyan anaglyphs."
msgstr "JPS solo puede describir anaglifos rojo/cian."

msgctxt "Stereo::PictureSave|"
msgid "The JPS descriptor is invalid or ambiguous; correct its fields before saving."
msgstr "El descriptor JPS no es válido o es ambiguo; corrija sus campos antes de guardar."

msgctxt "Stereo::PictureSave|"
msgid "The chosen JPS packing and separation do not fit the stored pixel dimensions."
msgstr "La disposición JPS y la separación elegidas no encajan en las dimensiones de píxeles almacenadas."

msgctxt "Stereo::PictureSave|"
msgid "The JPEG has unindexed trailing data; metadata-only save cannot preserve its offsets safely."
msgstr "El JPEG tiene datos finales sin índice; guardar solo los metadatos no puede preservar sus desplazamientos de forma segura."

msgctxt "Stereo::PictureSave|"
msgid "The picture could not be decoded with the chosen layout and eyes; the original was kept."
msgstr "No se pudo decodificar la imagen con la disposición y los ojos elegidos; se conservó el original."

msgctxt "Stereo::PictureSave|"
msgid "The temporary picture could not be written, read back or replaced; the original was kept."
msgstr "No se pudo escribir, releer o sustituir la imagen temporal; se conservó el original."

msgctxt "Stereo::PictureSave|"
msgid "The temporary picture's ownership, permissions or attributes could not be preserved."
msgstr "No se pudo preservar el propietario, los permisos o los atributos de la imagen temporal."

msgctxt "Stereo::PictureSave|"
msgid "The original picture changed during the save; retry with the current file."
msgstr "La imagen original cambió durante el guardado; vuelva a intentarlo con el archivo actual."

msgctxt "Stereo::PictureSave|"
msgid "MPO stores separate disparity views; it cannot describe the chosen packing or a monoscopic correction."
msgstr "MPO almacena vistas de disparidad separadas; no puede describir la disposición elegida ni una corrección monoscópica."

msgctxt "Stereo::FileChoiceMenu|"
msgid "3D Input Format"
msgstr "Formato de entrada 3D"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Automatic"
msgstr "Automático"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Not 3D"
msgstr "No es 3D"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Side by side, left eye first"
msgstr "Lado a lado, ojo izquierdo primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Side by side, right eye first"
msgstr "Lado a lado, ojo derecho primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Top and bottom, left eye first"
msgstr "Arriba y abajo, ojo izquierdo primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Top and bottom, right eye first"
msgstr "Arriba y abajo, ojo derecho primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Interleaved"
msgstr "Entrelazado"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Rows, left eye first"
msgstr "Filas, ojo izquierdo primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Rows, right eye first"
msgstr "Filas, ojo derecho primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Columns, left eye first"
msgstr "Columnas, ojo izquierdo primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Columns, right eye first"
msgstr "Columnas, ojo derecho primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Checkerboard, left eye first"
msgstr "Tablero de ajedrez, ojo izquierdo primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Checkerboard, right eye first"
msgstr "Tablero de ajedrez, ojo derecho primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Side by side quincunx, left eye first"
msgstr "Lado a lado en quincunce, ojo izquierdo primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Side by side quincunx, right eye first"
msgstr "Lado a lado en quincunce, ojo derecho primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Anaglyph"
msgstr "Anaglifo"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Red/cyan"
msgstr "Rojo/cian"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Green/magenta"
msgstr "Verde/magenta"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Amber/blue"
msgstr "Ámbar/azul"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Picture and depth"
msgstr "Imagen y profundidad"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Side by side, picture first"
msgstr "Lado a lado, imagen primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Side by side, depth first"
msgstr "Lado a lado, profundidad primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Top and bottom, picture first"
msgstr "Arriba y abajo, imagen primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Top and bottom, depth first"
msgstr "Arriba y abajo, profundidad primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Four rows: picture, depth, graphics, graphics depth"
msgstr "Cuatro filas: imagen, profundidad, gráficos, profundidad de los gráficos"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Four quarters: picture, depth, background, background depth"
msgstr "Cuatro cuartos: imagen, profundidad, fondo, profundidad del fondo"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Swap left and right eyes"
msgstr "Intercambiar los ojos izquierdo y derecho"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Show each eye the other view of this file"
msgstr "Mostrar a cada ojo la otra vista de este archivo"

msgctxt "Stereo::FileChoiceMenu|"
msgid "A stereo picture holds a view for each eye. When a file has them the wrong way round, this swaps them for this file. The choice is kept with the program's own state: the file is not changed."
msgstr "Una imagen estéreo contiene una vista para cada ojo. Cuando un archivo las tiene al revés, esto las intercambia para este archivo. La elección se guarda en el estado propio del programa: el archivo no se modifica."

msgctxt "Stereo::FileChoiceMenu|"
msgid "Save the correction into the file"
msgstr "Guardar la corrección en el archivo"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Write this correction into the file itself, so every program and device reads it"
msgstr "Escribir esta corrección en el propio archivo, para que la lea cualquier programa o dispositivo"

msgctxt "Stereo::FileChoiceMenu|"
msgid "%1 was not changed and its correction is kept: %2"
msgstr "%1 no se ha modificado y su corrección se conserva: %2"

msgctxt "Stereo::Picture|"
msgid "The choice for this file cannot be kept in %1: %2."
msgstr "La elección para este archivo no se puede guardar en %1: %2."

msgctxt "Stereo::Picture|"
msgid "This file has no 3D correction to save."
msgstr "Este archivo no tiene ninguna corrección 3D que guardar."

msgctxt "Stereo::Picture|"
msgid "A correction can be saved into JPEG, JPS and MPO pictures only; this file has another format."
msgstr "Una corrección solo se puede guardar en imágenes JPEG, JPS y MPO; este archivo tiene otro formato."

msgctxt "Stereo::FileChoiceMenu|"
msgid "One view after the other"
msgstr "Una vista tras otra"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Frames in turn, left eye first"
msgstr "Fotogramas alternos, ojo izquierdo primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Frames in turn, right eye first"
msgstr "Fotogramas alternos, ojo derecho primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Both views in one block, left eye first"
msgstr "Ambas vistas en un bloque, ojo izquierdo primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Both views in one block, right eye first"
msgstr "Ambas vistas en un bloque, ojo derecho primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "%1 (one view shown here)"
msgstr "%1 (aquí se muestra una vista)"

msgctxt "Stereo::Picture|"
msgid "The 3D choice of this file could not follow it to %1: %2."
msgstr "La elección 3D de este archivo no pudo seguirlo a %1: %2."

msgctxt "Stereo::FileChoiceMoves|"
msgid "The 3D choice of a file cannot follow the file when it is renamed or moved: the session bus cannot be reached (%1)."
msgstr "La elección 3D de un archivo no puede seguirlo cuando se renombra o se mueve: no se puede acceder al bus de sesión (%1)."

msgctxt "QObject|"
msgid "Colour is reconstructed and approximate: an anaglyph keeps only some of each eye's colour. The original file is never changed."
msgstr "El color se reconstruye y es aproximado: un anaglifo conserva solo una parte del color de cada ojo. El archivo original nunca se modifica."

msgctxt "Stereo::DepthControls|"
msgid "Picture and depth"
msgstr "Imagen y profundidad"

msgctxt "Stereo::DepthControls|"
msgid "Depth strength"
msgstr "Intensidad de la profundidad"

msgctxt "Stereo::DepthControls|"
msgid "How deep the picture looks: the largest parallax in front of and behind the screen, in pixels of a picture 1920 wide. 58 is about one degree of visual angle."
msgstr "La profundidad aparente de la imagen: la mayor paralaje por delante y por detrás de la pantalla, en píxeles de una imagen de 1920 de ancho. 58 equivale aproximadamente a un grado de ángulo visual."

msgctxt "Stereo::DepthControls|"
msgid "Screen plane"
msgstr "Plano de la pantalla"

msgctxt "Stereo::DepthControls|"
msgid "Where the screen is in the depth of the picture, from 0 (the farthest) to 1 (the nearest). What is nearer comes out of the screen, what is farther stays behind it."
msgstr "Dónde está la pantalla en la profundidad de la imagen, de 0 (lo más lejano) a 1 (lo más cercano). Lo que está más cerca sale de la pantalla; lo que está más lejos queda detrás de ella."

msgctxt "Stereo::DepthControls|"
msgid "Shift"
msgstr "Desplazamiento"

msgctxt "Stereo::DepthControls|"
msgid "The picture is"
msgstr "La imagen es"

msgctxt "Stereo::DepthControls|"
msgid "Which view the picture is. As the left eye it stays exactly as it is in that eye and the right eye is drawn; as the middle, both views are drawn."
msgstr "Qué vista es la imagen. Como ojo izquierdo, queda exactamente como está en ese ojo y se dibuja el ojo derecho; como vista central, se dibujan las dos vistas."

msgctxt "Stereo::DepthControls|"
msgid "the left eye"
msgstr "el ojo izquierdo"

msgctxt "Stereo::DepthControls|"
msgid "the middle"
msgstr "la vista central"

msgctxt "Stereo::DepthControls|"
msgid "Gap filling"
msgstr "Relleno de huecos"

msgctxt "Stereo::DepthControls|"
msgid "How the places that the picture does not show, behind the objects in front, are filled."
msgstr "Cómo se rellenan los lugares que la imagen no muestra, detrás de los objetos que están delante."

msgctxt "Stereo::DepthControls|"
msgid "Background"
msgstr "Fondo"

msgctxt "Stereo::DepthControls|"
msgid "Depth-aided"
msgstr "Guiado por la profundidad"

msgctxt "Stereo::DepthControls|"
msgid "Inpainting"
msgstr "Reconstrucción (inpainting)"

msgctxt "Stereo::DepthControls|"
msgid "None"
msgstr "Ninguno"

msgctxt "Stereo::DepthControls|"
msgid "Warping"
msgstr "Deformación"

msgctxt "Stereo::DepthControls|"
msgid "Forward"
msgstr "Hacia delante"

msgctxt "Stereo::DepthControls|"
msgid "Backward"
msgstr "Hacia atrás"

msgctxt "Stereo::DepthControls|"
msgid "Layered"
msgstr "Por capas"

msgctxt "Stereo::DepthControls|"
msgid "Smooth the depth"
msgstr "Suavizar la profundidad"

msgctxt "Stereo::DepthControls|"
msgid "Filling reach"
msgstr "Alcance del relleno"

msgctxt "Stereo::DepthControls|"
msgid "Nearest distance"
msgstr "Distancia más cercana"

msgctxt "Stereo::DepthControls|"
msgid "Farthest distance"
msgstr "Distancia más lejana"

msgctxt "Stereo::DepthControls|"
msgid "Back to the default"
msgstr "Volver al valor predeterminado"

msgctxt "Stereo::DepthControls|"
msgid "Pyramid"
msgstr "Pirámide"

msgctxt "Stereo::DepthControls|"
msgid "Automatic"
msgstr "Automático"

msgctxt "Stereo::DepthControls|"
msgid "A still picture and a picture saved into a file are drawn the best way there is. A video is drawn the best way that keeps its frame rate on this machine, timed once for each GPU and picture size. Choosing a warping or a gap filling yourself turns this off: your choice then holds for everything, the slowest way included."
msgstr "Una imagen fija y una imagen guardada en un archivo se dibujan de la mejor manera que existe. Un vídeo se dibuja de la mejor manera que mantiene su velocidad de fotogramas en este equipo, medida una vez para cada GPU y cada tamaño de imagen. Elegir usted mismo una deformación o un relleno de huecos lo desactiva: su elección vale entonces para todo, incluida la manera más lenta."

msgctxt "Stereo::DepthControls|"
msgid "on this GPU"
msgstr "en esta GPU"

msgctxt "Stereo::DepthControls|"
msgid "on this processor"
msgstr "en este procesador"

msgctxt "Stereo::DepthControls|"
msgid "%1 (keeps %2 frames a second %3)"
msgstr "%1 (mantiene %2 fotogramas por segundo %3)"

msgctxt "Stereo::DepthControls|"
msgid "%1 (%2 does not keep %3 frames a second %4)"
msgstr "%1 (%2 no mantiene %3 fotogramas por segundo %4)"

msgctxt "Stereo::DepthControls|"
msgid "%1 (the quickest: no way keeps %2 frames a second %3)"
msgstr "%1 (la más rápida: ninguna manera mantiene %2 fotogramas por segundo %3)"

msgctxt "Stereo::DepthControls|"
msgid "%1 (the GPU was reset while drawing: the processor draws now)"
msgstr "%1 (la GPU se reinició mientras dibujaba: ahora dibuja el procesador)"

msgctxt "Stereo::DepthControls|"
msgid "%1 (%2 needs more of the GPU's memory than is free)"
msgstr "%1 (%2 necesita más memoria de la GPU de la que hay libre)"

msgctxt "Stereo::DepthControls|"
msgid "%1 (needs about %2 MB of the GPU's memory, %3 MB is free)"
msgstr "%1 (necesita unos %2 MB de la memoria de la GPU; hay %3 MB libres)"
