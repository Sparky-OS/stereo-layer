msgstr "Arriba y abajo, imagen primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Top and bottom, depth first"
msgstr "Arriba y abajo, profundidad primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Four rows: picture, depth, graphics, graphics depth"
msgstr "Cuatro filas: imagen, profundidad, gráficos, profundidad de los gráficos"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Four quarters: picture, depth, background, background depth"
msgstr "Cuatro cuartos: imagen, profundidad, fondo, profundidad del fondo"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Swap left and right eyes"
msgstr "Intercambiar los ojos izquierdo y derecho"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Show each eye the other view of this file"
msgstr "Mostrar a cada ojo la otra vista de este archivo"

msgctxt "Stereo::FileChoiceMenu|"
msgid "A stereo picture holds a view for each eye. When a file has them the wrong way round, this swaps them for this file. The choice is kept with the program's own state: the file is not changed."
msgstr "Una imagen estéreo contiene una vista para cada ojo. Cuando un archivo las tiene al revés, esto las intercambia para este archivo. La elección se guarda en el estado propio del programa: el archivo no se modifica."

msgctxt "Stereo::FileChoiceMenu|"
msgid "Save the correction into the file"
msgstr "Guardar la corrección en el archivo"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Write this correction into the file itself, so every program and device reads it"
msgstr "Escribir esta corrección en el propio archivo, para que la lea cualquier programa o dispositivo"

msgctxt "Stereo::FileChoiceMenu|"
msgid "%1 was not changed and its correction is kept: %2"
msgstr "%1 no se ha modificado y su corrección se conserva: %2"

msgctxt "Stereo::Picture|"
msgid "The choice for this file cannot be kept in %1: %2."
msgstr "La elección para este archivo no se puede guardar en %1: %2."

msgctxt "Stereo::Picture|"
msgid "This file has no 3D correction to save."
msgstr "Este archivo no tiene ninguna corrección 3D que guardar."

msgctxt "Stereo::Picture|"
msgid "A correction can be saved into JPEG, JPS and MPO pictures only; this file has another format."
msgstr "Una corrección solo se puede guardar en imágenes JPEG, JPS y MPO; este archivo tiene otro formato."

msgctxt "Stereo::FileChoiceMenu|"
msgid "One view after the other"
msgstr "Una vista tras otra"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Frames in turn, left eye first"
msgstr "Fotogramas alternos, ojo izquierdo primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Frames in turn, right eye first"
msgstr "Fotogramas alternos, ojo derecho primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Both views in one block, left eye first"
msgstr "Ambas vistas en un bloque, ojo izquierdo primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Both views in one block, right eye first"
msgstr "Ambas vistas en un bloque, ojo derecho primero"

msgctxt "Stereo::FileChoiceMenu|"
msgid "%1 (one view shown here)"
msgstr "%1 (aquí se muestra una vista)"

msgctxt "Stereo::Picture|"
msgid "The 3D choice of this file could not follow it to %1: %2."
msgstr "La elección 3D de este archivo no pudo seguirlo a %1: %2."

msgctxt "Stereo::FileChoiceMoves|"
msgid "The 3D choice of a file cannot follow the file when it is renamed or moved: the session bus cannot be reached (%1)."
msgstr "La elección 3D de un archivo no puede seguirlo cuando se renombra o se mueve: no se puede acceder al bus de sesión (%1)."
