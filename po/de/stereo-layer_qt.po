msgstr "Schachbrett, linkes Auge zuerst"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Checkerboard, right eye first"
msgstr "Schachbrett, rechtes Auge zuerst"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Side by side quincunx, left eye first"
msgstr "Nebeneinander im Quincunx-Raster, linkes Auge zuerst"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Side by side quincunx, right eye first"
msgstr "Nebeneinander im Quincunx-Raster, rechtes Auge zuerst"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Anaglyph"
msgstr "Anaglyphe"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Red/cyan"
msgstr "Rot/Cyan"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Green/magenta"
msgstr "Grün/Magenta"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Amber/blue"
msgstr "Bernstein/Blau"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Picture and depth"
msgstr "Bild und Tiefe"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Side by side, picture first"
msgstr "Nebeneinander, Bild zuerst"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Side by side, depth first"
msgstr "Nebeneinander, Tiefe zuerst"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Top and bottom, picture first"
msgstr "Übereinander, Bild zuerst"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Top and bottom, depth first"
msgstr "Übereinander, Tiefe zuerst"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Four rows: picture, depth, graphics, graphics depth"
msgstr "Vier Zeilen: Bild, Tiefe, Grafik, Grafiktiefe"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Four quarters: picture, depth, background, background depth"
msgstr "Vier Viertel: Bild, Tiefe, Hintergrund, Hintergrundtiefe"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Swap left and right eyes"
msgstr "Linkes und rechtes Auge vertauschen"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Show each eye the other view of this file"
msgstr "Jedem Auge die andere Ansicht dieser Datei zeigen"

msgctxt "Stereo::FileChoiceMenu|"
msgid "A stereo picture holds a view for each eye. When a file has them the wrong way round, this swaps them for this file. The choice is kept with the program's own state: the file is not changed."
msgstr "Ein Stereobild enthält eine Ansicht für jedes Auge. Wenn eine Datei sie verkehrt herum enthält, vertauscht dies sie für diese Datei. Die Wahl wird im eigenen Zustand des Programms aufbewahrt: Die Datei wird nicht verändert."

msgctxt "Stereo::FileChoiceMenu|"
msgid "Save the correction into the file"
msgstr "Korrektur in die Datei speichern"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Write this correction into the file itself, so every program and device reads it"
msgstr "Diese Korrektur in die Datei selbst schreiben, damit jedes Programm und jedes Gerät sie liest"

msgctxt "Stereo::FileChoiceMenu|"
msgid "%1 was not changed and its correction is kept: %2"
msgstr "%1 wurde nicht verändert und die Korrektur bleibt erhalten: %2"

msgctxt "Stereo::Picture|"
msgid "The choice for this file cannot be kept in %1: %2."
msgstr "Die Wahl für diese Datei kann nicht in %1 aufbewahrt werden: %2."

msgctxt "Stereo::Picture|"
msgid "This file has no 3D correction to save."
msgstr "Diese Datei hat keine 3D-Korrektur zum Speichern."

msgctxt "Stereo::Picture|"
msgid "A correction can be saved into JPEG, JPS and MPO pictures only; this file has another format."
msgstr "Eine Korrektur kann nur in JPEG-, JPS- und MPO-Bilder gespeichert werden; diese Datei hat ein anderes Format."

msgctxt "Stereo::FileChoiceMenu|"
msgid "One view after the other"
msgstr "Eine Ansicht nach der anderen"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Frames in turn, left eye first"
msgstr "Bilder im Wechsel, linkes Auge zuerst"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Frames in turn, right eye first"
msgstr "Bilder im Wechsel, rechtes Auge zuerst"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Both views in one block, left eye first"
msgstr "Beide Ansichten in einem Block, linkes Auge zuerst"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Both views in one block, right eye first"
msgstr "Beide Ansichten in einem Block, rechtes Auge zuerst"

msgctxt "Stereo::FileChoiceMenu|"
msgid "%1 (one view shown here)"
msgstr "%1 (hier wird eine Ansicht gezeigt)"

msgctxt "Stereo::Picture|"
msgid "The 3D choice of this file could not follow it to %1: %2."
msgstr "Die 3D-Wahl dieser Datei konnte ihr nicht nach %1 folgen: %2."

msgctxt "Stereo::FileChoiceMoves|"
msgid "The 3D choice of a file cannot follow the file when it is renamed or moved: the session bus cannot be reached (%1)."
msgstr "Die 3D-Wahl einer Datei kann der Datei beim Umbenennen oder Verschieben nicht folgen: Der Sitzungsbus ist nicht erreichbar (%1)."
