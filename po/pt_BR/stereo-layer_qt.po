msgctxt "Stereo::FileChoiceMenu|"
msgid "Interleaved"
msgstr "Entrelaçado"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Rows, left eye first"
msgstr "Linhas, olho esquerdo primeiro"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Rows, right eye first"
msgstr "Linhas, olho direito primeiro"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Columns, left eye first"
msgstr "Colunas, olho esquerdo primeiro"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Columns, right eye first"
msgstr "Colunas, olho direito primeiro"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Checkerboard, left eye first"
msgstr "Xadrez, olho esquerdo primeiro"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Checkerboard, right eye first"
msgstr "Xadrez, olho direito primeiro"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Side by side quincunx, left eye first"
msgstr "Lado a lado em quincôncio, olho esquerdo primeiro"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Side by side quincunx, right eye first"
msgstr "Lado a lado em quincôncio, olho direito primeiro"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Anaglyph"
msgstr "Anaglifo"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Red/cyan"
msgstr "Vermelho/ciano"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Green/magenta"
msgstr "Verde/magenta"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Amber/blue"
msgstr "Âmbar/azul"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Picture and depth"
msgstr "Imagem e profundidade"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Side by side, picture first"
msgstr "Lado a lado, imagem primeiro"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Side by side, depth first"
msgstr "Lado a lado, profundidade primeiro"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Top and bottom, picture first"
msgstr "Em cima e embaixo, imagem primeiro"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Top and bottom, depth first"
msgstr "Em cima e embaixo, profundidade primeiro"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Four rows: picture, depth, graphics, graphics depth"
msgstr "Quatro faixas: imagem, profundidade, gráficos, profundidade dos gráficos"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Four quarters: picture, depth, background, background depth"
msgstr "Quatro quartos: imagem, profundidade, fundo, profundidade do fundo"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Swap left and right eyes"
msgstr "Trocar o olho esquerdo e o direito"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Show each eye the other view of this file"
msgstr "Mostrar a cada olho a outra vista deste arquivo"

msgctxt "Stereo::FileChoiceMenu|"
msgid "A stereo picture holds a view for each eye. When a file has them the wrong way round, this swaps them for this file. The choice is kept with the program's own state: the file is not changed."
msgstr "Uma imagem estéreo contém uma vista para cada olho. Quando um arquivo as tem invertidas, isto as troca para este arquivo. A escolha fica guardada no estado do próprio programa: o arquivo não é alterado."

msgctxt "Stereo::FileChoiceMenu|"
msgid "Save the correction into the file"
msgstr "Salvar a correção no arquivo"

msgctxt "Stereo::FileChoiceMenu|"
msgid "Write this correction into the file itself, so every program and device reads it"
msgstr "Gravar esta correção no próprio arquivo, para que qualquer programa ou aparelho a leia"

msgctxt "Stereo::FileChoiceMenu|"
msgid "%1 was not changed and its correction is kept: %2"
msgstr "%1 não foi alterado e sua correção continua guardada: %2"

msgctxt "Stereo::Picture|"
msgid "The choice for this file cannot be kept in %1: %2."
msgstr "A escolha para este arquivo não pode ser guardada em %1: %2."

msgctxt "Stereo::Picture|"
msgid "This file has no 3D correction to save."
msgstr "Este arquivo não tem correção 3D para salvar."
