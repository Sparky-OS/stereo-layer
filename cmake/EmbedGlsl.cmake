# Writes OUTPUT, a C file with each GLSL file of FILES (a list) as a zero-terminated byte array stereo_dibr_glsl_<name>,
# the file name with its dot replaced by an underscore: cmake -DOUTPUT=... "-DFILES=a;b" -P EmbedGlsl.cmake
set(code "/* Generated by cmake/EmbedGlsl.cmake from src/dibr/glsl: do not edit. */\n\n")
foreach(file IN LISTS FILES)
    get_filename_component(name "${file}" NAME)
    string(REPLACE "." "_" name "${name}")
    file(READ "${file}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND code "const char stereo_dibr_glsl_${name}[] = {\n    ${bytes}0x00\n};\n\n")
endforeach()
file(WRITE "${OUTPUT}" "${code}")
